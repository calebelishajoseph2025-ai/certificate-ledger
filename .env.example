# ─────────────────────────────────────────────────────────────────────────────
# Certificate Ledger — Example Environment Configuration
# Copy this file to `.env` and fill in your own values.
#   cp .env.example .env
# Generate secrets with:  openssl rand -hex 32   (or:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ────────────────────────────────────────────────────────────────
# PostgreSQL connection string. This ACTIVATES durable persistence:
#   - Set to a live Postgres (Supabase Transaction pooler, port 6543, ?sslmode=require)
#     and every ledger mutation is saved durably; cold boots hydrate from it.
#   - Leave as localhost docker (docker compose -f docker-compose.dev.yml up -d)
#     for local dev with a real database.
#   - Comment out entirely for memory-only mode (state resets on restart).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres

# The app reads only DATABASE_URL. Migrations (supabase/*.sql) are pasted into
# the Supabase SQL Editor; DIRECT_URL below is reserved for Python tooling.
# DIRECT_URL=

# Separate database for integration tests, if used
# TEST_DATABASE_URL=

# ── Authentication & Secrets ────────────────────────────────────────────────
# Passcode to unlock the organizer dashboard
ORGANIZER_PASSCODE=change-me

# Confirmation key for factory-resetting the in-memory ledger (organizer session still required)
SYSTEM_RESET_KEY=system_reset_csi_2026

# Secret used to sign session cookies (≥ 32 chars)
SESSION_SECRET=<run openssl rand -hex 32>

# Secret used for HMAC QR-link signatures and audit checkpoints
# (≥ 32 chars and must DIFFER from SESSION_SECRET)
LEDGER_SIGNING_KEY=<run openssl rand -hex 32>

# Optional previous key for zero-downtime key rotation
# LEDGER_SIGNING_KEY_PREVIOUS=

# ── Rate Limits (F4 brute-force protection) ─────────────────────────────────
RATE_LIMIT_VERIFY_PER_MIN=30
RATE_LIMIT_NOTFOUND_PER_10MIN=10
RATE_LIMIT_LOGIN_FAILS_PER_15MIN=5
RATE_LIMIT_SOCIAL_PER_MIN=120

# ── Certificate Branding ────────────────────────────────────────────────────
ISSUER_NAME=Northwind Learning Collective
SIGNATORY_1_NAME=Dr. Amara Okonkwo
SIGNATORY_1_TITLE=Program Director
SIGNATORY_2_NAME=Lucas Brandt
SIGNATORY_2_TITLE=Head of Faculty

# ── URLs ────────────────────────────────────────────────────────────────────
# Base URL embedded in signed QR codes / verify links
PUBLIC_BASE_URL=http://localhost:3000

# ── Dev Server Options (optional) ───────────────────────────────────────────
# Set to "true" to disable Vite HMR
# DISABLE_HMR=false
