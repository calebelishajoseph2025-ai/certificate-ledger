# ==============================================================================
# Certificate Ledger Environment Variables Example Template
# Copy this file to .env and fill in your Supabase credentials
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE & SUPABASE POSTGRES CONNECTION
# ------------------------------------------------------------------------------

# Transaction Pooler (Port 6543) via PgBouncer for serverless queries
# Where to find in Supabase:
#   1. Open your project at https://supabase.com/dashboard
#   2. Click "Connect" at top center (or Project Settings -> Database -> Connection string)
#   3. Select the "URI" tab
#   4. Under "Mode", choose "Transaction" (port 6543)
#   5. Copy the connection string and replace [YOUR-PASSWORD] with your actual database password
# Format: postgresql://postgres.[project-ref]:[YOUR-PASSWORD]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=

# Session / Direct Mode (Port 5432) for DDL migrations & table setup
# Where to find in Supabase:
#   1. In the same "Connect" popup (or Project Settings -> Database)
#   2. Under "Mode", choose "Session" (port 5432)
#   3. Copy the connection string and replace [YOUR-PASSWORD] with your database password
# Format: postgresql://postgres.[project-ref]:[YOUR-PASSWORD]@aws-0-[region].pooler.supabase.com:5432/postgres
DATABASE_URL_UNPOOLED=
DIRECT_URL=

# Serverless connection pool limit (recommended: 5)
PG_POOL_MAX=5

# ------------------------------------------------------------------------------
# 2. SUPABASE REST & API CREDENTIALS
# ------------------------------------------------------------------------------

# Supabase Project URL (REST and Auth endpoint)
# Where to find in Supabase:
#   Project Settings -> API -> "Project URL"
# Format: https://[project-ref].supabase.co
SUPABASE_URL=

# Supabase Anonymous Public Key
# Where to find in Supabase:
#   Project Settings -> API -> Project API keys -> "anon" / "public"
SUPABASE_ANON_KEY=
SUPABASE_PUBLISHABLE_KEY=

# Supabase Service Role Secret Key (Bypasses Row Level Security for ledger synchronization)
# Where to find in Supabase:
#   Project Settings -> API -> Project API keys -> "service_role" (click "Reveal")
# Note: Keep this secret; never expose it to client-side code!
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SECRET_KEY=

# ------------------------------------------------------------------------------
# 3. SECURITY & AUTHENTICATION
# ------------------------------------------------------------------------------

# Organizer access passcode (typed by administrators to log into the ledger)
ORGANIZER_PASSCODE=demo2026

# Admin secret key to trigger a hard reset to factory state (POST /api/system/reset)
SYSTEM_RESET_KEY=system_reset_csi_2026

# 64-character hexadecimal secret used to sign session cookies
# Generate with: openssl rand -hex 32
SESSION_SECRET=a8f9c2e4b6d0123456789abcdef0123456789abcdef0123456789abcdef01234

# 64-character hexadecimal cryptographic signing key for QR codes & tamper verification
# (MUST be different from SESSION_SECRET). Generate with: openssl rand -hex 32
LEDGER_SIGNING_KEY=d7e5f3a1c9b80123456789abcdef0123456789abcdef0123456789abcdef01234
LEDGER_SIGNING_KEY_PREVIOUS=

# ------------------------------------------------------------------------------
# 4. APP BRANDING & PUBLIC HOST
# ------------------------------------------------------------------------------

PUBLIC_BASE_URL=http://localhost:3000
ISSUER_NAME=Northwind Learning Collective
SIGNATORY_1_NAME=Dr. Amara Okonkwo
SIGNATORY_1_TITLE=Program Director
SIGNATORY_2_NAME=Lucas Brandt
SIGNATORY_2_TITLE=Head of Faculty

# ------------------------------------------------------------------------------
# 5. PUBLIC ENDPOINT RATE LIMITS (Defaults shown)
# ------------------------------------------------------------------------------

RATE_LIMIT_VERIFY_PER_MIN=30
RATE_LIMIT_NOTFOUND_PER_10MIN=10
RATE_LIMIT_LOGIN_FAILS_PER_15MIN=5
RATE_LIMIT_SOCIAL_PER_MIN=120